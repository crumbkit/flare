{
  "$defs": {
    "ActivityItem": {
      "description": "One item of the activity feed, tagged by `kind`.",
      "oneOf": [
        {
          "description": "A share that responds to a flare with `--re`.",
          "properties": {
            "also": {
              "description": "The other flares it responds to that the caller can open.",
              "items": {
                "$ref": "#/$defs/FlareRef"
              },
              "type": "array"
            },
            "at": {
              "description": "When it named the flare, in RFC 3339 UTC.",
              "type": "string"
            },
            "by": {
              "description": "Its owner's identifier.",
              "type": "string"
            },
            "flare": {
              "description": "The flare it responds to.",
              "type": "string"
            },
            "format": {
              "$ref": "#/$defs/Format",
              "description": "Its markup."
            },
            "kind": {
              "const": "response",
              "type": "string"
            },
            "share": {
              "description": "The responding share's id.",
              "type": "string"
            },
            "title": {
              "description": "Its title.",
              "type": "string"
            },
            "version": {
              "description": "The version of the flare it responds to.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "flare",
            "share",
            "title",
            "format",
            "by",
            "version",
            "at",
            "also"
          ],
          "type": "object"
        },
        {
          "description": "A comment on a flare.",
          "properties": {
            "at": {
              "description": "When it was written, in RFC 3339 UTC.",
              "type": "string"
            },
            "body": {
              "description": "Its text.",
              "type": "string"
            },
            "by": {
              "description": "Its author's identifier.",
              "type": "string"
            },
            "comment": {
              "description": "The comment's id.",
              "type": "string"
            },
            "flare": {
              "description": "The flare.",
              "type": "string"
            },
            "kind": {
              "const": "comment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "flare",
            "comment",
            "by",
            "body",
            "at"
          ],
          "type": "object"
        },
        {
          "description": "A reply to a comment.",
          "properties": {
            "at": {
              "description": "When it was written, in RFC 3339 UTC.",
              "type": "string"
            },
            "body": {
              "description": "Its text.",
              "type": "string"
            },
            "by": {
              "description": "Its author's identifier.",
              "type": "string"
            },
            "comment": {
              "description": "The reply's id.",
              "type": "string"
            },
            "flare": {
              "description": "The flare.",
              "type": "string"
            },
            "kind": {
              "const": "reply",
              "type": "string"
            },
            "parent": {
              "description": "The comment it answers.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "flare",
            "comment",
            "parent",
            "by",
            "body",
            "at"
          ],
          "type": "object"
        },
        {
          "description": "A comment or reply whose author changed its text.",
          "properties": {
            "at": {
              "description": "When it changed, in RFC 3339 UTC.",
              "type": "string"
            },
            "body": {
              "description": "Its text now.",
              "type": "string"
            },
            "by": {
              "description": "Its author's identifier.",
              "type": "string"
            },
            "comment": {
              "description": "The comment's id.",
              "type": "string"
            },
            "flare": {
              "description": "The flare.",
              "type": "string"
            },
            "kind": {
              "const": "edited",
              "type": "string"
            },
            "parent": {
              "description": "The comment a reply answers; none for a comment.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "flare",
            "comment",
            "by",
            "body",
            "at"
          ],
          "type": "object"
        },
        {
          "description": "A comment or reply whose author deleted it.",
          "properties": {
            "at": {
              "description": "When it was deleted, in RFC 3339 UTC.",
              "type": "string"
            },
            "by": {
              "description": "Its author's identifier.",
              "type": "string"
            },
            "comment": {
              "description": "The comment's id.",
              "type": "string"
            },
            "flare": {
              "description": "The flare.",
              "type": "string"
            },
            "kind": {
              "const": "deleted",
              "type": "string"
            },
            "parent": {
              "description": "The comment a reply answers; none for a comment.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "flare",
            "comment",
            "by",
            "at"
          ],
          "type": "object"
        }
      ]
    },
    "ActivityPage": {
      "description": "`GET /api/activity?flare=<id>&since=<cursor>&since_last=<name>&limit=N`.",
      "properties": {
        "cursor": {
          "description": "The cursor to pass as `since` next time.",
          "type": "string"
        },
        "items": {
          "description": "The items, oldest first.",
          "items": {
            "$ref": "#/$defs/ActivityItem"
          },
          "type": "array"
        },
        "more": {
          "description": "Whether more items follow the cursor now.",
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "cursor",
        "more"
      ],
      "type": "object"
    },
    "Comment": {
      "description": "A top-level comment with its replies.",
      "properties": {
        "at": {
          "description": "When it was written, in RFC 3339 UTC.",
          "type": "string"
        },
        "author": {
          "description": "Its author's identifier.",
          "type": "string"
        },
        "body": {
          "description": "Its text, absent once deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "deleted": {
          "description": "Whether its author deleted it. A deleted comment has no body.",
          "type": "boolean"
        },
        "edited": {
          "description": "When its text last changed, in RFC 3339 UTC; absent when it never did.",
          "type": [
            "string",
            "null"
          ]
        },
        "flare": {
          "description": "The flare it is on.",
          "type": "string"
        },
        "id": {
          "description": "The comment's id.",
          "type": "string"
        },
        "replies": {
          "description": "Its replies, oldest first.",
          "items": {
            "$ref": "#/$defs/Reply"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "flare",
        "author",
        "at",
        "deleted",
        "replies"
      ],
      "type": "object"
    },
    "CommentEdit": {
      "additionalProperties": false,
      "description": "`PATCH /api/comments/{id}`: the new text.",
      "properties": {
        "body": {
          "description": "The text, 1 to 8,000 characters.",
          "type": "string"
        }
      },
      "required": [
        "body"
      ],
      "type": "object"
    },
    "CommentOrReply": {
      "description": "The answer to writing, editing or deleting one comment or reply, tagged\nby `kind`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Comment",
          "description": "A comment, with no replies in a write's answer.",
          "properties": {
            "kind": {
              "const": "comment",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Reply",
          "description": "A reply.",
          "properties": {
            "kind": {
              "const": "reply",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "CommentThread": {
      "description": "`GET /api/comments?flare=<id>`: a flare's comments with their replies,\noldest first.",
      "properties": {
        "comments": {
          "description": "Its comments.",
          "items": {
            "$ref": "#/$defs/Comment"
          },
          "type": "array"
        },
        "flare": {
          "description": "The flare.",
          "type": "string"
        }
      },
      "required": [
        "flare",
        "comments"
      ],
      "type": "object"
    },
    "ExchangeRequest": {
      "additionalProperties": false,
      "description": "`POST /api/tokens/exchange`: a login code for a token.",
      "properties": {
        "code": {
          "description": "The one-use code the browser handed to the CLI.",
          "type": "string"
        },
        "label": {
          "description": "The token's label, such as the name of the Mac.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "label"
      ],
      "type": "object"
    },
    "FieldKind": {
      "description": "What a field's values are.",
      "oneOf": [
        {
          "const": "keyword",
          "description": "One of the listed values.",
          "type": "string"
        },
        {
          "const": "person",
          "description": "A person: `me`, an email address or a name the server knows.",
          "type": "string"
        }
      ]
    },
    "FlareRef": {
      "description": "A flare that a response also responds to, which the caller can open.",
      "properties": {
        "id": {
          "description": "The flare's id.",
          "type": "string"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "Format": {
      "description": "The markup of a share's content.",
      "oneOf": [
        {
          "const": "markdown",
          "description": "Markdown, which every deployment serves.",
          "type": "string"
        },
        {
          "const": "html",
          "description": "An uploaded HTML file, which a deployment with a content host serves\nin a sandboxed frame. It travels as a multipart upload, never as the\nJSON `content` field.",
          "type": "string"
        }
      ]
    },
    "GrantEntry": {
      "description": "One grant of a share.",
      "properties": {
        "audience": {
          "description": "For an everyone grant, its audience: the mail domain it opens to, or\n`admitted` for the deployment's email list.",
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "description": "When the grant was first written, in RFC 3339 UTC.",
          "type": "string"
        },
        "granted_by": {
          "description": "Who wrote the grant's current role.",
          "type": "string"
        },
        "grantee": {
          "description": "The person's identifier, `team:<name>` or `everyone`. A grant to a\nteam that the caller, a share admin, does not belong to shows\n`team:*`, so no one outside a team learns its name.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GranteeKind",
          "description": "Who the grant is to."
        },
        "role": {
          "$ref": "#/$defs/Role",
          "description": "The grant's role; a team or everyone grant is always `reader`."
        },
        "state": {
          "$ref": "#/$defs/GrantState",
          "description": "Whether the grant opens the share."
        }
      },
      "required": [
        "grantee",
        "kind",
        "role",
        "state",
        "granted_by",
        "created"
      ],
      "type": "object"
    },
    "GrantList": {
      "description": "`GET /api/grants/{id}`: a share's grants, for its owner and its admins.",
      "properties": {
        "items": {
          "description": "The grants, oldest first.",
          "items": {
            "$ref": "#/$defs/GrantEntry"
          },
          "type": "array"
        },
        "share": {
          "description": "The share.",
          "type": "string"
        }
      },
      "required": [
        "share",
        "items"
      ],
      "type": "object"
    },
    "GrantRequest": {
      "additionalProperties": false,
      "description": "`POST /api/grants/{id}`: more people, teams or everyone, or more flares\nthe share responds to.",
      "properties": {
        "everyone": {
          "description": "Grant Reader to everyone signed in whom the deployment's admit rule\ncovers. Only the share's owner may. A body without it grants no\neveryone grant.",
          "type": "boolean"
        },
        "re": {
          "default": [],
          "description": "The ids of more flares the share responds to. Only its owner names\nthem.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "with": {
          "default": [],
          "description": "Who to share with: each a person's identifier, `team:<name>` for a\nteam the caller belongs to, or `everyone`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "GrantState": {
      "description": "Whether a grant opens the share.",
      "oneOf": [
        {
          "const": "active",
          "description": "The grant opens the share to its grantee.",
          "type": "string"
        },
        {
          "const": "dormant",
          "description": "The grant is to a team that is being deleted, or to a name no team\nhas, and opens nothing. The team's delete removes it, and the\nshare's owner may remove it with `flare revoke`.",
          "type": "string"
        }
      ]
    },
    "GranteeKind": {
      "description": "Who a grant is to.",
      "oneOf": [
        {
          "const": "person",
          "description": "One person.",
          "type": "string"
        },
        {
          "const": "team",
          "description": "The members of a team.",
          "type": "string"
        },
        {
          "const": "everyone",
          "description": "Everyone signed in whom the grant's audience covers.",
          "type": "string"
        }
      ]
    },
    "MembersChanged": {
      "description": "The answer to adding or removing members.",
      "properties": {
        "changed": {
          "description": "The addresses added or removed. One already present, or already\nabsent, is left out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "team": {
          "$ref": "#/$defs/TeamSummary",
          "description": "The team after the change."
        }
      },
      "required": [
        "team",
        "changed"
      ],
      "type": "object"
    },
    "MembersRequest": {
      "additionalProperties": false,
      "description": "`POST` and `DELETE /api/teams/{name}/members`: the people to add or\nremove.",
      "properties": {
        "with": {
          "description": "Each person's identifier, which the deployment resolves to an\naddress.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "with"
      ],
      "type": "object"
    },
    "NamedCursor": {
      "additionalProperties": false,
      "description": "`GET` and `PUT /api/cursors/{name}`: a named position in the activity\nfeed, kept for the caller.",
      "properties": {
        "cursor": {
          "description": "The activity cursor. A `PUT` moves the saved one only when this is\nfurther on, and the answer holds the cursor saved.",
          "type": "string"
        }
      },
      "required": [
        "cursor"
      ],
      "type": "object"
    },
    "NewComment": {
      "additionalProperties": false,
      "description": "`POST /api/comments`: a comment on a flare, or a reply to one of its\ncomments.",
      "properties": {
        "body": {
          "description": "The text, 1 to 8,000 characters.",
          "type": "string"
        },
        "flare": {
          "description": "The flare.",
          "type": "string"
        },
        "key": {
          "description": "The client's key for this write, 1 to 64 characters of letters,\ndigits, `.`, `_` and `-`. Sending the same key again answers the\nfirst comment and writes nothing.",
          "type": "string"
        },
        "parent": {
          "description": "The comment to reply to; absent for a comment.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "flare",
        "body",
        "key"
      ],
      "type": "object"
    },
    "OpenedShare": {
      "description": "`GET /api/shares/{id}?version=n`: version `n` of a share the caller can\nopen, or its latest version without `n`.",
      "properties": {
        "content": {
          "description": "That version's content.",
          "type": "string"
        },
        "share": {
          "$ref": "#/$defs/ShareSummary",
          "description": "The share, whose `version` is its latest."
        },
        "version": {
          "description": "The number of the version whose content this answer holds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "share",
        "version",
        "content"
      ],
      "type": "object"
    },
    "ProblemDocument": {
      "description": "An RFC 9457 problem document with flare's code and recovery.",
      "properties": {
        "code": {
          "description": "The stable code, `flare::<area>::<kind>`.",
          "type": "string"
        },
        "detail": {
          "description": "What exactly is wrong, when the title does not say. It never holds\nan address or a secret.",
          "type": [
            "string",
            "null"
          ]
        },
        "errors": {
          "description": "Each error of a search that did not run, in the order of its text.",
          "items": {
            "$ref": "#/$defs/SearchError"
          },
          "type": "array"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the caller does next."
        },
        "share": {
          "description": "The share that a partly finished share created.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "The HTTP status.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "description": "The one-line title.",
          "type": "string"
        },
        "type": {
          "description": "Always `about:blank`: the code names the problem.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code"
      ],
      "type": "object"
    },
    "Recovery": {
      "description": "What the caller does next, in the shape of crumbkit's JSON failure\ndocument: an object tagged by `kind`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Run this command line.",
          "properties": {
            "call": {
              "description": "The command line, such as `flare login https://flare.example.org`.",
              "type": "string"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Run the same command again later.",
          "properties": {
            "kind": {
              "const": "retry",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Follow this advice.",
          "properties": {
            "kind": {
              "const": "hint",
              "type": "string"
            },
            "text": {
              "description": "The advice.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "Reply": {
      "description": "A reply to a comment. A reply has no replies of its own.",
      "properties": {
        "at": {
          "description": "When it was written, in RFC 3339 UTC.",
          "type": "string"
        },
        "author": {
          "description": "Its author's identifier.",
          "type": "string"
        },
        "body": {
          "description": "Its text, absent once deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "deleted": {
          "description": "Whether its author deleted it. A deleted reply has no body.",
          "type": "boolean"
        },
        "edited": {
          "description": "When its text last changed, in RFC 3339 UTC; absent when it never did.",
          "type": [
            "string",
            "null"
          ]
        },
        "flare": {
          "description": "The flare it is on.",
          "type": "string"
        },
        "id": {
          "description": "The reply's id.",
          "type": "string"
        },
        "parent": {
          "description": "The comment it answers.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "flare",
        "parent",
        "author",
        "at",
        "deleted"
      ],
      "type": "object"
    },
    "RevokeRequest": {
      "additionalProperties": false,
      "description": "`DELETE /api/grants/{id}`: the grants to end.",
      "properties": {
        "everyone": {
          "default": false,
          "description": "End the grant to everyone signed in.",
          "type": "boolean"
        },
        "with": {
          "default": [],
          "description": "Whose grant to end: each a person's identifier, which the deployment\nresolves, or `team:<name>`, or `everyone`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Revoked": {
      "description": "The answer to `DELETE /api/grants/{id}`.",
      "properties": {
        "revoked": {
          "description": "The addresses, `team:<name>` and `everyone` whose grant ended. One\nthat held no grant is left out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "share": {
          "description": "The share.",
          "type": "string"
        }
      },
      "required": [
        "share",
        "revoked"
      ],
      "type": "object"
    },
    "Role": {
      "description": "What the caller is to a share.",
      "oneOf": [
        {
          "const": "owner",
          "description": "The caller owns it.",
          "type": "string"
        },
        {
          "const": "admin",
          "description": "The caller holds an Admin grant.",
          "type": "string"
        },
        {
          "const": "reader",
          "description": "The caller holds a Reader grant.",
          "type": "string"
        }
      ]
    },
    "SearchAnswer": {
      "description": "`GET /api/search?q=<text>&limit=N`: the shares the caller can open that\nmatch the query.",
      "properties": {
        "next": {
          "description": "The cursor of the next page. A search answers one page, so it is\nalways null.",
          "type": [
            "string",
            "null"
          ]
        },
        "parsed": {
          "description": "The query's parts, in the order they were typed.",
          "items": {
            "$ref": "#/$defs/SearchPart"
          },
          "type": "array"
        },
        "partial": {
          "description": "Whether the caller's own shares or the shares granted to the caller\npassed the 500 that one search reads, so a match may be missing.",
          "type": "boolean"
        },
        "query": {
          "description": "The query's canonical text.",
          "type": "string"
        },
        "results": {
          "description": "The matching shares, newest first.",
          "items": {
            "$ref": "#/$defs/ShareSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "query",
        "parsed",
        "results",
        "partial"
      ],
      "type": "object"
    },
    "SearchError": {
      "description": "One error in a search's text, which a problem document lists.",
      "properties": {
        "code": {
          "description": "The stable code, such as `flare::search::unknown_field`: flare's\nprefix before the code the case file spells.",
          "type": "string"
        },
        "message": {
          "description": "How to fix it, in one sentence.",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SearchSpan",
          "description": "The characters it covers."
        }
      },
      "required": [
        "code",
        "span",
        "message"
      ],
      "type": "object"
    },
    "SearchField": {
      "description": "One field a search can filter on.",
      "properties": {
        "about": {
          "description": "What it matches, in one sentence.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FieldKind",
          "description": "What its values are."
        },
        "name": {
          "description": "The field's name, such as `type`.",
          "type": "string"
        },
        "values": {
          "description": "The values a builder offers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind",
        "values",
        "about"
      ],
      "type": "object"
    },
    "SearchFields": {
      "description": "`GET /api/search/fields`: every field a search can filter on.",
      "properties": {
        "fields": {
          "description": "The fields, in the order a builder offers them.",
          "items": {
            "$ref": "#/$defs/SearchField"
          },
          "type": "array"
        }
      },
      "required": [
        "fields"
      ],
      "type": "object"
    },
    "SearchPart": {
      "description": "One parsed part of a search, tagged by `kind`.",
      "oneOf": [
        {
          "description": "A word, which matches inside a title in any case.",
          "properties": {
            "kind": {
              "const": "word",
              "type": "string"
            },
            "negated": {
              "description": "Whether a leading minus excludes what it matches.",
              "type": "boolean"
            },
            "span": {
              "$ref": "#/$defs/SearchSpan",
              "description": "Where it was typed, minus included."
            },
            "text": {
              "description": "The word.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text",
            "negated",
            "span"
          ],
          "type": "object"
        },
        {
          "description": "A quoted phrase, which matches as one string.",
          "properties": {
            "kind": {
              "const": "phrase",
              "type": "string"
            },
            "negated": {
              "description": "Whether a leading minus excludes what it matches.",
              "type": "boolean"
            },
            "span": {
              "$ref": "#/$defs/SearchSpan",
              "description": "Where it was typed, minus and quotes included."
            },
            "text": {
              "description": "The phrase, without quotes.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text",
            "negated",
            "span"
          ],
          "type": "object"
        },
        {
          "description": "A filter, which matches when any of its values does.",
          "properties": {
            "field": {
              "description": "The field, such as `from`.",
              "type": "string"
            },
            "kind": {
              "const": "filter",
              "type": "string"
            },
            "negated": {
              "description": "Whether a leading minus excludes what it matches.",
              "type": "boolean"
            },
            "span": {
              "$ref": "#/$defs/SearchSpan",
              "description": "Where it was typed, minus included."
            },
            "values": {
              "description": "The values, at least one.",
              "items": {
                "$ref": "#/$defs/SearchValue"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "field",
            "values",
            "negated",
            "span"
          ],
          "type": "object"
        }
      ]
    },
    "SearchSpan": {
      "description": "The characters a part or an error covers in the query, counted in\nUnicode scalar values from 0. `end` is exclusive.",
      "properties": {
        "end": {
          "description": "The character after the last one.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "The first character.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "SearchValue": {
      "description": "One value of a filter, with its span. A quoted value's span includes\nits quotes.",
      "properties": {
        "span": {
          "$ref": "#/$defs/SearchSpan",
          "description": "Where it was typed."
        },
        "text": {
          "description": "The value, without quotes.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "span"
      ],
      "type": "object"
    },
    "ShareList": {
      "description": "`GET /api/shares?scope=mine|with-me&limit=N&cursor=<cursor>`.",
      "properties": {
        "items": {
          "description": "The shares, newest first.",
          "items": {
            "$ref": "#/$defs/ShareSummary"
          },
          "type": "array"
        },
        "more": {
          "description": "Whether more shares follow this page; true exactly when `next` is\npresent.",
          "type": "boolean"
        },
        "next": {
          "description": "The cursor to pass as `cursor` for the page that follows, present\nonly when more shares follow. A page can hold fewer than `limit`\nshares and still name one, when a share granted to the caller no\nlonger exists.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "more"
      ],
      "type": "object"
    },
    "ShareRequest": {
      "additionalProperties": false,
      "description": "`POST /api/shares`: a new share.",
      "properties": {
        "content": {
          "description": "The Markdown, at most 256 KiB. An HTML share sends it empty and puts the\nfile in the form's `html` part.",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format",
          "description": "The markup of `content`."
        },
        "re": {
          "default": [],
          "description": "The ids of the flares this share responds to.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "description": "The title, 1 to 200 bytes.",
          "type": "string"
        },
        "with": {
          "default": [],
          "description": "Who to share with: each an identifier that the deployment resolves,\nwhich by default is an email address, or `team:<name>` for a team\nthe caller belongs to, or `everyone`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "title",
        "format",
        "content"
      ],
      "type": "object"
    },
    "ShareSummary": {
      "description": "One share as a list or a reply shows it.",
      "properties": {
        "comments": {
          "description": "How many live comments and replies the flare holds. Only an opened\nshare carries it.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "created": {
          "description": "When the share was created, in RFC 3339 UTC.",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format",
          "description": "The markup."
        },
        "id": {
          "description": "The share's id.",
          "type": "string"
        },
        "owner": {
          "description": "The owner's identifier.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "description": "What the caller is to the share."
        },
        "title": {
          "description": "The title.",
          "type": "string"
        },
        "version": {
          "description": "The latest version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "format",
        "owner",
        "role",
        "version",
        "created"
      ],
      "type": "object"
    },
    "Shared": {
      "description": "The answer to `POST /api/shares` and `POST /api/shares/{id}/grants`.",
      "properties": {
        "granted": {
          "description": "The addresses, `team:<name>` and `everyone` granted Reader by this\nrequest.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "responds_to": {
          "description": "The flares the share responds to that this request named.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "share": {
          "$ref": "#/$defs/ShareSummary",
          "description": "The share."
        }
      },
      "required": [
        "share",
        "granted",
        "responds_to"
      ],
      "type": "object"
    },
    "TeamDeleted": {
      "description": "The answer to `DELETE /api/teams/{name}`. One call removes at most 200\nof the team's grants; a team with more answers `finished` false, and\nthe owner repeats the call to go on.",
      "properties": {
        "finished": {
          "description": "Whether the team is gone: its grant removed from every share, its\nmembers removed and its name free for a new team. When false the\nteam opens nothing and keeps its name until a repeat finishes.",
          "type": "boolean"
        },
        "grants_removed": {
          "description": "How many share grants this call removed.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "team": {
          "description": "The team's name.",
          "type": "string"
        }
      },
      "required": [
        "team",
        "finished",
        "grants_removed"
      ],
      "type": "object"
    },
    "TeamList": {
      "description": "`GET /api/teams`: the teams the caller belongs to.",
      "properties": {
        "items": {
          "description": "The teams, by name.",
          "items": {
            "$ref": "#/$defs/TeamSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "TeamManagedBy": {
      "description": "Who keeps a team.",
      "oneOf": [
        {
          "const": "flare",
          "description": "flare keeps the team, and its owner changes it. A summary from a\nserver that predates this field means this.",
          "type": "string"
        },
        {
          "const": "directory",
          "description": "The deployment's directory keeps the team. It has no owner, and\nflare cannot change it.",
          "type": "string"
        }
      ]
    },
    "TeamRequest": {
      "additionalProperties": false,
      "description": "`POST /api/teams`: a new team.",
      "properties": {
        "name": {
          "description": "The name: 1 to 40 lowercase letters, digits and dashes, which no\nteam in the deployment has.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "TeamRole": {
      "description": "What the caller is to a team.",
      "oneOf": [
        {
          "const": "owner",
          "description": "The caller owns the team and alone manages it.",
          "type": "string"
        },
        {
          "const": "member",
          "description": "The caller is a member.",
          "type": "string"
        }
      ]
    },
    "TeamShown": {
      "description": "`GET /api/teams/{name}`: a team and its members, for a member.",
      "properties": {
        "members": {
          "description": "The members' addresses, in address order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "team": {
          "$ref": "#/$defs/TeamSummary",
          "description": "The team."
        }
      },
      "required": [
        "team",
        "members"
      ],
      "type": "object"
    },
    "TeamSummary": {
      "description": "One team as a list or a reply shows it.",
      "properties": {
        "created": {
          "description": "When flare created the team, in RFC 3339 UTC. A directory team has\nnone, and the field is left out.",
          "type": [
            "string",
            "null"
          ]
        },
        "managed_by": {
          "$ref": "#/$defs/TeamManagedBy",
          "default": "flare",
          "description": "Who keeps the team: `flare` or `directory`."
        },
        "members": {
          "description": "How many members the team has, its owner included.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "The team's name.",
          "type": "string"
        },
        "owner": {
          "description": "The owner's identifier. A team that the deployment's directory\nkeeps has none, and the field is left out.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/TeamRole",
          "description": "What the caller is to the team. A directory team has only members."
        }
      },
      "required": [
        "name",
        "role",
        "members"
      ],
      "type": "object"
    },
    "TokenIssued": {
      "description": "The answer to an exchange. The token appears here once and nowhere\nelse; the server keeps only its digest.",
      "properties": {
        "expires": {
          "description": "When it stops working, in RFC 3339 UTC.",
          "type": "string"
        },
        "id": {
          "description": "The token's id, which `flare logout` revokes.",
          "type": "string"
        },
        "label": {
          "description": "Its label.",
          "type": "string"
        },
        "owner": {
          "description": "The address it authenticates as.",
          "type": "string"
        },
        "token": {
          "description": "The bearer token.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "token",
        "owner",
        "label",
        "expires"
      ],
      "type": "object"
    },
    "TransferRequest": {
      "additionalProperties": false,
      "description": "The body of `PUT /api/teams/{name}/owner`: the member who becomes the\nteam's owner.",
      "properties": {
        "to": {
          "description": "The new owner's identifier, which the deployment resolves to an\naddress. The person must be a member of the team.",
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "type": "object"
    },
    "VersionRequest": {
      "additionalProperties": false,
      "description": "`POST /api/shares/{id}/versions`: the next version of a share, which\nonly its owner may publish. A new version changes the content and\nnothing else.",
      "properties": {
        "content": {
          "description": "The Markdown, at most 256 KiB. An HTML share sends it empty and puts the\nfile in the form's `html` part.",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format",
          "description": "The markup of `content`."
        }
      },
      "required": [
        "format",
        "content"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flare API"
}
