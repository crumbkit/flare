{
  "$schema": "https://unpkg.com/knip@6.43.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "flare": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "*.ts"]
    },
    "headless": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    },
    "react": { "project": ["src/**/*.{ts,tsx}", "*.ts"] }
  }
}
