{
  "name": "flare-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "lint": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "typecheck": "pnpm --recursive --filter './*' run typecheck",
    "knip": "knip",
    "test": "pnpm --recursive --filter './*' run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "knip": "6.45.1"
  }
}
