{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flare/activity/v1",
  "description": "The responses to the named flares, oldest first, and the cursor of the next call.",
  "type": "object",
  "properties": {
    "cut": {
      "description": "Present when the output budget cut the result short, so data holds only its first rows.",
      "type": "object",
      "properties": {
        "budget": {
          "description": "The most bytes that the run printed on standard output.",
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "description": "The over-budget code.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "budget"
      ]
    },
    "data": {
      "description": "The rows of the page, up to the limit.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActivityRow"
      }
    },
    "dry_run": {
      "description": "Present, and true, when the run was a dry run that changed nothing.",
      "const": true
    },
    "next": {
      "description": "The next steps, in the order the text prints them. It is absent when there are none.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commands": {
            "description": "The commands that carry out the step, in order.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "call": {
                      "description": "A command line of this tool.",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "call"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "run": {
                      "description": "A command line of another program.",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "run"
                  ]
                }
              ]
            }
          },
          "text": {
            "description": "The sentence or phrase that the text prints for the step.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "text",
          "commands"
        ]
      }
    },
    "schema": {
      "description": "The id of this document.",
      "const": "flare/activity/v1"
    },
    "summary": {
      "$ref": "#/$defs/Next"
    },
    "total": {
      "description": "The number of rows that matched, of which data holds one page. It is absent when the tool did not count the rows.",
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "description": "True when the document leaves out rows that matched, because of the limit or the output budget, and false when data holds every row.",
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "data",
    "truncated",
    "summary"
  ],
  "$defs": {
    "ActivityRow": {
      "description": "One response in `flare activity`.",
      "type": "object",
      "properties": {
        "also": {
          "description": "The other flares it responds to that the caller can open.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "at": {
          "description": "When it named the flare, in RFC 3339 UTC.",
          "type": "string"
        },
        "by": {
          "description": "The responder's identifier.",
          "type": "string"
        },
        "flare": {
          "description": "The flare it responds to.",
          "type": "string"
        },
        "share": {
          "description": "The responding share's id.",
          "type": "string"
        },
        "title": {
          "description": "The responding share's title.",
          "type": "string"
        },
        "version": {
          "description": "The version of the flare it responds to.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "flare",
        "share",
        "title",
        "by",
        "version",
        "at",
        "also"
      ]
    },
    "Next": {
      "description": "Where the next `flare activity` starts.",
      "type": "object",
      "properties": {
        "cursor": {
          "description": "The cursor to pass as `--since`.",
          "type": "string"
        },
        "more": {
          "description": "Whether newer responses wait past this page.",
          "type": "boolean"
        }
      },
      "required": [
        "cursor",
        "more"
      ]
    }
  }
}
