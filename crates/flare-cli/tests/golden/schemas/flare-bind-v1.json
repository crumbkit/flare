{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flare/bind/v1",
  "description": "The binding that was saved and the page version it is pinned to.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/Bound"
    },
    "dry_run": {
      "description": "Present, and true, when the run was a dry run that changed nothing.",
      "const": true
    },
    "schema": {
      "description": "The id of this document.",
      "const": "flare/bind/v1"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "$defs": {
    "Bound": {
      "description": "What `flare bind` saved, or would save.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The binding's name.",
          "type": "string"
        },
        "page": {
          "description": "The page the binding fills.",
          "type": "string"
        },
        "version": {
          "description": "The page version the binding is pinned to.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "page",
        "version"
      ]
    }
  }
}
