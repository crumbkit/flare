{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flare/search/v1",
  "description": "The shares the caller can open that match a search, newest first, and the search's canonical text.",
  "type": "object",
  "properties": {
    "cut": {
      "description": "Present when the output budget cut the result short, so data holds only its first rows.",
      "type": "object",
      "properties": {
        "budget": {
          "description": "The most bytes that the run printed on standard output.",
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "description": "The over-budget code.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "budget"
      ]
    },
    "data": {
      "description": "The rows of the page, up to the limit.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShareRow"
      }
    },
    "dry_run": {
      "description": "Present, and true, when the run was a dry run that changed nothing.",
      "const": true
    },
    "next": {
      "description": "The next steps, in the order the text prints them. It is absent when there are none.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commands": {
            "description": "The commands that carry out the step, in order.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "call": {
                      "description": "A command line of this tool.",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "call"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "run": {
                      "description": "A command line of another program.",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "run"
                  ]
                }
              ]
            }
          },
          "text": {
            "description": "The sentence or phrase that the text prints for the step.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "text",
          "commands"
        ]
      }
    },
    "schema": {
      "description": "The id of this document.",
      "const": "flare/search/v1"
    },
    "summary": {
      "$ref": "#/$defs/SearchSummary"
    },
    "total": {
      "description": "The number of rows that matched, of which data holds one page. It is absent when the tool did not count the rows.",
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "description": "True when the document leaves out rows that matched, because of the limit or the output budget, and false when data holds every row.",
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "data",
    "truncated",
    "summary"
  ],
  "$defs": {
    "SearchSummary": {
      "description": "What a search printed besides its rows.",
      "type": "object",
      "properties": {
        "partial": {
          "description": "Whether your own shares or the shares granted to you passed the 500\nthat one search reads, so a match may be missing.",
          "type": "boolean"
        },
        "query": {
          "description": "The query's canonical text, as the server read it.",
          "type": "string"
        }
      },
      "required": [
        "query",
        "partial"
      ]
    },
    "ShareRow": {
      "description": "One share in `flare shares`.",
      "type": "object",
      "properties": {
        "created": {
          "description": "When it was created, in RFC 3339 UTC.",
          "type": "string"
        },
        "id": {
          "description": "The share's id.",
          "type": "string"
        },
        "owner": {
          "description": "The owner's identifier.",
          "type": "string"
        },
        "role": {
          "description": "The caller's role: `owner`, `admin` or `reader`.",
          "type": "string"
        },
        "title": {
          "description": "The share's title.",
          "type": "string"
        },
        "version": {
          "description": "The latest version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "title",
        "owner",
        "role",
        "version",
        "created"
      ]
    }
  }
}
