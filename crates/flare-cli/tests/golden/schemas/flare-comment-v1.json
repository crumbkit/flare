{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flare/comment/v1",
  "description": "The comment written. A repeated --key answers the first comment and writes nothing.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/CommentOut"
    },
    "dry_run": {
      "description": "Present, and true, when the run was a dry run that changed nothing.",
      "const": true
    },
    "schema": {
      "description": "The id of this document.",
      "const": "flare/comment/v1"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "$defs": {
    "CommentOut": {
      "description": "One comment or reply, as `flare comment`, `reply`, `comment-edit` and\n`comment-delete` print it.",
      "type": "object",
      "properties": {
        "at": {
          "description": "When it was written, in RFC 3339 UTC.",
          "type": "string"
        },
        "author": {
          "description": "The author's identifier.",
          "type": "string"
        },
        "body": {
          "description": "Its text; absent once deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "deleted": {
          "description": "Whether its author deleted it.",
          "type": "boolean"
        },
        "edited": {
          "description": "When its text last changed, in RFC 3339 UTC; absent when it never did.",
          "type": [
            "string",
            "null"
          ]
        },
        "flare": {
          "description": "The flare it is on.",
          "type": "string"
        },
        "id": {
          "description": "The comment's or reply's id.",
          "type": "string"
        },
        "parent": {
          "description": "The comment a reply answers; absent for a comment.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "flare",
        "parent",
        "author",
        "at",
        "edited",
        "deleted",
        "body"
      ]
    }
  }
}
