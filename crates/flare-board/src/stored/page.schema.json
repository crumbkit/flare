{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`flare/page/v1`: one version of a flare page. The page's text is the file beside it, page.html or page.md, and the commit that changed this record is the version's name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$type", "format", "slots", "made_by", "made_from", "sources", "previous"],
  "properties": {
    "$type": {"const": "flare/page/v1"},
    "format": {"enum": ["html", "markdown"], "description": "The markup language of the page's text."},
    "slots": {
      "type": "array",
      "maxItems": 32,
      "description": "The places in the page that records of one type fill.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "editable_fields", "sample"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
          "type": {"type": "string"},
          "editable_fields": {"type": "array", "items": {"type": "string"}},
          "sample": {
            "description": "An example record shown when nothing fills the slot, or null.",
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "body"],
                "properties": {"type": {"type": "string"}, "body": {"type": "string"}}
              }
            ]
          }
        }
      }
    },
    "made_by": {"type": "string", "description": "The id of the principal who published this version."},
    "made_from": {"$ref": "#/$defs/MadeFrom"},
    "sources": {"type": "array", "maxItems": 64, "items": {"type": "string"}, "description": "The records this version was derived from, by path."},
    "previous": {"type": ["string", "null"], "description": "The version this one replaced, or null for the first."}
  },
  "$defs": {
    "MadeFrom": {
      "description": "What the page was made from.",
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "original"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "page", "version"], "properties": {"kind": {"const": "page"}, "page": {"type": "string"}, "version": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "binding"], "properties": {"kind": {"const": "binding"}, "binding": {"type": "string"}}}
      ]
    }
  }
}
