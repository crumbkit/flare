{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hangar/publish/v1",
  "description": "The page that was published, with its new version.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/Published"
    },
    "dry_run": {
      "description": "Present, and true, when the run was a dry run that changed nothing.",
      "const": true
    },
    "schema": {
      "description": "The id of this document.",
      "const": "hangar/publish/v1"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "$defs": {
    "Published": {
      "description": "What `hangar publish` published, or would publish.",
      "type": "object",
      "properties": {
        "format": {
          "description": "The page's markup language: `html` or `markdown`.",
          "type": "string"
        },
        "name": {
          "description": "The page's name.",
          "type": "string"
        },
        "slots": {
          "description": "The names of the page's slots.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "description": "The new version, or none on a dry run.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "format",
        "slots"
      ]
    }
  }
}
